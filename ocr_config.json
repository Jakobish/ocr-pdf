{
  "input_dir": ".",
  "include_glob": ["*.pdf"],
  "exclude_glob": ["OCR/**", "*/OCR/**"],
  "sort_by": "none",
  "max_files": 0,
  "print_every": 1,
  "jobs": "auto",
  "overwrite": false,
  "timeout": 0,
  "ocrmypdf_args": [
    "-l",
    "heb+eng",
    "--rotate-pages",
    "--redo-ocr",
    "--output-type",
    "pdfa",
    "--optimize",
    "1"
  ]
}
